#!/bin/sh
# Офлайн-кэш (sw.js) замечает новую версию сайта только по VERSION.
# Не даём закоммитить файлы сайта, если VERSION не поднят, и новые файлы, которых нет в FILES.
# Включить в свежей копии репо: git config core.hooksPath .githooks

# файлы сайта = всё, кроме заметок, служебных папок и самого sw.js
site=$(git diff --cached --name-only --diff-filter=ACMRD | grep -vE '^(sw\.js|README\.md|CLAUDE\.md|\.githooks/|\.claude/|\.gitignore|\.gitattributes|\.nojekyll)')
[ -z "$site" ] && exit 0

if ! git diff --cached -U0 -- sw.js | grep -qE "^\+const VERSION ="; then
  echo "pre-commit: меняются файлы сайта, а VERSION в sw.js тот же."
  echo "Подними VERSION (например verstak-N+1), иначе телефоны не увидят обновление:"
  echo "$site" | sed 's/^/  /'
  exit 1
fi

# новые файлы сайта должны попасть в офлайн-кэш
missing=""
for f in $(git diff --cached --name-only --diff-filter=A | grep -vE '^(sw\.js|README\.md|CLAUDE\.md|\.githooks/|\.claude/|\.gitignore|\.gitattributes|\.nojekyll|fonts/LICENSE|vendor/three/LICENSE)'); do
  git show ":sw.js" | grep -qF "'$f'" || missing="$missing\n  $f"
done
if [ -n "$missing" ]; then
  printf "pre-commit: новых файлов нет в FILES в sw.js, офлайн они не откроются:%b\n" "$missing"
  exit 1
fi
exit 0
